---
import { u, beacon } from '../data/site.js';
const { title, description, theme = null, path = '/', ld = [], image = '/img/avatar.jpg', noindex = false } = Astro.props;
const canon = 'https://vidatu.com' + path;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Vidatu', url: 'https://vidatu.com/', logo: 'https://vidatu.com/img/avatar.jpg', sameAs: ['https://www.youtube.com/@vidatutv'] };
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title><meta name="description" content={description}>
<link rel="canonical" href={canon}>{(import.meta.env.BASE_URL !== "/" || noindex) && <meta name="robots" content="noindex">}{beacon && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}<link rel="icon" href={u('/img/avatar.jpg')}>
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={'https://vidatu.com' + image}><meta property="og:url" content={canon}><meta property="og:site_name" content="Vidatu"><meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
{[org, ...ld].map(x => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
<style is:global>
:root{--ink:#120E2A;--violet:#1A1340;--cream:#FBF7EA;--mint:#7CFFCB;--amber:#FFB52E;--oob:#6C4DFF;--absurd:#FF6B5E;--approved:#4DE08A;--review:#B9A6FF}
*{box-sizing:border-box}html{scroll-behavior:smooth}[hidden]{display:none!important}
body{margin:0;color:var(--cream);background:var(--ink);font-family:"Bricolage Grotesque",system-ui,sans-serif;font-size:18px;line-height:1.5}
a{color:inherit}a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible{outline:3px solid var(--mint);outline-offset:3px;border-radius:3px}
img,video{max-width:100%;display:block}
.wrap{max-width:1160px;margin:0 auto;padding:0 22px}
.top{display:flex;justify-content:space-between;align-items:center;gap:6px 24px;flex-wrap:wrap;padding:22px 0}
.mark{font-weight:800;font-size:24px;text-decoration:none;letter-spacing:-.01em;display:flex;align-items:center;gap:10px}.mark img{width:34px;height:34px;border-radius:50%}
.top nav{display:flex;gap:4px 20px;flex-wrap:wrap;font-size:16px}.top nav a{text-decoration:none;border-bottom:2px solid transparent;padding-bottom:2px}.top nav a:hover{border-bottom-color:var(--mint)}
h1{font-size:clamp(46px,8.2vw,112px);line-height:.9;margin:0 0 26px;font-weight:800;font-variation-settings:"wdth" 78;letter-spacing:-.03em}
h2{font-size:clamp(32px,5.2vw,60px);line-height:.98;margin:0 0 26px;font-weight:800;font-variation-settings:"wdth" 84;letter-spacing:-.02em}
h3{font-size:23px;line-height:1.2;margin:0;font-weight:700}
p{margin:0 0 24px}.lede{font-size:clamp(19px,2vw,23px);max-width:30em;line-height:1.45}.note{max-width:36em}
.kicker{display:flex;gap:6px 26px;flex-wrap:wrap;font-size:15px;margin:0 0 24px;padding:0;list-style:none;color:var(--mint)}.kicker span{opacity:.7;margin-right:8px;color:var(--cream)}
.btn{display:inline-block;background:var(--amber);color:var(--ink);text-decoration:none;padding:14px 24px 15px;border-radius:999px;line-height:1.2;border:0;font:inherit;font-weight:700;cursor:pointer}
.btn:hover{background:var(--cream)}.btn.ghost{background:transparent;color:inherit;box-shadow:inset 0 0 0 2px currentColor}.btn.ghost:hover{background:var(--cream);color:var(--ink)}
.actions{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.stamp{display:inline-block;font-weight:800;font-variation-settings:"wdth" 75;text-transform:uppercase;letter-spacing:.06em;line-height:1;padding:7px 12px 8px;border:3px solid currentColor;border-radius:6px;transform:rotate(-7deg);white-space:nowrap}
.stamp.absurd{color:var(--absurd)}.stamp.approved{color:var(--approved)}.stamp.review{color:var(--review)}
.band{padding:72px 0}
.stage{background:var(--violet);position:relative;overflow:hidden}
.stage::before{content:"";position:absolute;inset:auto auto -30% -10%;width:70%;aspect-ratio:1;border-radius:50%;background:radial-gradient(closest-side,rgba(108,77,255,.55),transparent);pointer-events:none}
.hero{display:grid;gap:10px 40px;align-items:center;padding:26px 0 40px;position:relative}
@media(min-width:900px){.hero{grid-template-columns:1.15fr .85fr;padding:20px 0 30px}}
.hero h1 em{font-style:normal;color:var(--amber)}
.specimen{position:relative;margin:0}
.hero .specimen video{width:100%;max-width:470px;margin:0 auto;-webkit-mask-image:radial-gradient(ellipse 62% 60% at 50% 48%,#000 68%,transparent 100%);mask-image:radial-gradient(ellipse 62% 60% at 50% 48%,#000 68%,transparent 100%)}
.hero .specimen .stamp{position:absolute;left:2%;bottom:9%;font-size:clamp(20px,2.6vw,30px);background:var(--violet)}
@media(prefers-reduced-motion:no-preference){.specimen .stamp{animation:slam .5s cubic-bezier(.2,1.6,.4,1) 1s both}@keyframes slam{from{opacity:0;transform:rotate(-18deg) scale(2.6)}to{opacity:1;transform:rotate(-7deg) scale(1)}}}
.holos{display:grid;gap:16px;list-style:none;margin:0;padding:0}@media(min-width:860px){.holos{grid-template-columns:repeat(3,1fr)}}
.holo{display:flex;flex-direction:column;gap:12px;height:100%;padding:22px 22px 24px;border:1.5px solid var(--mint);border-radius:16px;text-decoration:none;color:var(--cream);
  background:repeating-linear-gradient(to bottom,rgba(124,255,203,.07) 0 2px,transparent 2px 6px),rgba(124,255,203,.05);box-shadow:0 0 34px rgba(124,255,203,.13);transition:transform .15s}
a.holo:hover{transform:translateY(-4px);box-shadow:0 0 46px rgba(124,255,203,.3)}
.holo .no{color:var(--mint);font-weight:800;font-size:17px;letter-spacing:.08em}.holo p{margin:0;opacity:.85;font-size:16px;line-height:1.45}.holo .stamp{font-size:18px;align-self:flex-start;margin-top:auto}
.world{padding:64px 0;background:var(--bg);color:var(--fg);overflow:hidden}
.world .grid{display:grid;gap:26px 48px;align-items:center}@media(min-width:860px){.world .grid{grid-template-columns:1fr 1fr}.world:nth-of-type(even) .pic{order:2}}
.world h2{font-size:clamp(60px,12vw,168px);line-height:.82;margin:0 0 18px;font-variation-settings:"wdth" 75;letter-spacing:-.035em}
.world .fmt{font-weight:700;font-size:16px;letter-spacing:.04em;margin:0 0 14px;opacity:.85}
.world p.line{font-size:clamp(19px,2.1vw,24px);line-height:1.35;max-width:22em;margin:0 0 20px}
.world .pic video,.world .pic img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:22px;box-shadow:0 26px 60px rgba(0,0,0,.35)}
.world .soon{display:inline-block;font-size:15px;font-weight:700;padding:7px 14px 8px;border-radius:999px;box-shadow:inset 0 0 0 2px currentColor;opacity:.85}
.lab{background:#070B20;padding:80px 0}.lab h2{color:var(--amber)}.lab .grid{display:grid;gap:27px 48px;align-items:center}@media(min-width:900px){.lab .grid{grid-template-columns:.9fr 1.1fr}}
#wave{width:100%;height:440px;border-radius:18px;background:linear-gradient(#16245A,#0A0F2A);cursor:pointer;touch-action:manipulation}
.controls{display:flex;gap:10px 18px;align-items:center;flex-wrap:wrap;margin-top:14px;font-size:16px}.controls input{accent-color:var(--amber)}.controls .btn{padding:9px 16px 10px}#wave-t{font-variant-numeric:tabular-nums}
.light{background:var(--cream);color:var(--ink)}
.crumbs{font-size:15px;margin:0 0 24px;opacity:.85}.crumbs a{text-underline-offset:3px}
.article{display:grid;gap:27px 54px;padding-bottom:54px}@media(min-width:960px){.article{grid-template-columns:minmax(0,1fr) 380px;align-items:start}.article aside{position:sticky;top:27px}}
@media(max-width:959px){.article aside{order:-1}.article aside p{display:none}}
main{overflow-x:clip}
@media(max-width:700px){.article aside .stamp{right:8px;font-size:20px}}
.article aside img{border-radius:18px}.article aside .stamp{position:absolute;right:-6px;bottom:-12px;font-size:24px;background:var(--ink)}
.answer{border:1.5px solid var(--mint);background:rgba(124,255,203,.06);border-radius:16px;padding:24px 24px 2px;margin:0 0 27px}.answer b{display:block;color:var(--mint);font-size:15px;margin-bottom:6px}.answer p{font-size:21px;line-height:1.4}
.prose p,.prose ol{max-width:36em}.prose h2{font-size:30px;margin-top:34px}.prose ol{margin:0 0 27px;padding-left:22px}.prose a{color:var(--mint)}
details{border-bottom:1.5px solid rgba(251,247,234,.35);max-width:40em}details:first-of-type{border-top:1.5px solid rgba(251,247,234,.35)}
summary{cursor:pointer;font-weight:700;font-size:20px;padding:14px 0;list-style:none;display:flex;justify-content:space-between;gap:16px}summary::-webkit-details-marker{display:none}summary::after{content:"+";font-weight:400;color:var(--mint)}details[open] summary::after{content:"−"}details>*:not(summary){margin:0 0 24px}
.pager{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;border-top:1.5px solid rgba(251,247,234,.35);padding:24px 0 0;margin-top:54px}
footer{background:#0B0819;color:var(--cream);padding:54px 0;font-size:16px}footer .cols{display:grid;gap:27px}@media(min-width:760px){footer .cols{grid-template-columns:1.4fr 1fr 1fr}}footer b{display:block;margin-bottom:8px;color:var(--mint)}footer ul{list-style:none;margin:0;padding:0}footer a{text-underline-offset:3px}
.percy{position:fixed;inset:0 0 auto 0;height:7px;background:rgba(255,255,255,.14);z-index:60;--sp:0%}
.percy i{position:absolute;inset:0 auto 0 0;width:var(--sp);background:#FFD23F;border-radius:0 6px 6px 0}
.percy b,.percy em{opacity:0;transition:opacity .25s}.percy.on b,.percy.on em{opacity:1}
.percy b{position:absolute;left:clamp(17px,var(--sp),calc(100% - 17px));top:-3px;width:30px;height:30px;margin-left:-15px;border-radius:50%;background:#FFD23F;box-shadow:0 3px 10px rgba(0,0,0,.35)}
.percy b::before,.percy b::after{content:"";position:absolute;top:10px;width:5px;height:7px;border-radius:50%;background:#17122B}.percy b::before{left:8px}.percy b::after{right:8px}
.percy u{position:absolute;left:50%;bottom:6px;width:10px;height:5px;margin-left:-5px;border-radius:0 0 10px 10px;background:#17122B}
.percy.stall u{height:3px;border-radius:2px;bottom:7px}.percy.stall b{animation:jit .18s linear infinite}@keyframes jit{50%{transform:translateX(1.5px)}}
.percy em{position:absolute;left:clamp(22px,var(--sp),calc(100% - 22px));top:32px;transform:translateX(-50%);font-style:normal;font-size:12px;font-weight:700;background:#17122B;color:#FFD23F;padding:1px 7px;border-radius:999px;white-space:nowrap}
#melt{position:fixed;inset:0;z-index:-1;background:var(--ink)}
.melt .stage,.melt .world,.melt .lab,.melt .band:not(.light){background:transparent!important}
.melt .stage::before{display:none}
.world .pic,.world .txt{will-change:transform}
@media(min-width:860px){.world{min-height:88vh;display:grid;align-items:center}.world>.wrap{width:100%}}
@media(max-width:520px){.actions .btn{padding:12px 17px 13px;font-size:16px}.actions{gap:10px}}
@media(prefers-reduced-motion:no-preference){.fx .world .pic{transform:translateX(calc((1 - var(--p,1))*var(--dir,1)*-22vw)) rotate(calc((1 - var(--p,1))*var(--dir,1)*-14deg)) scale(calc(.72 + .28*var(--p,1)))}.fx .world .txt{transform:translateX(calc((1 - var(--p,1))*var(--dir,1)*14vw));opacity:calc(.15 + .85*var(--p,1))}.fx .holo{transform:translateY(calc((1 - var(--p,1))*60px));opacity:var(--p,1)}}
.world .pic video,.world .pic img{transform:rotate(calc(var(--dir,1)*-2deg))}
#oob-live{width:100%;max-width:560px;aspect-ratio:3/4;margin:0 auto;display:block;cursor:pointer;touch-action:manipulation}
.hero .hint{text-align:center;font-size:15px;opacity:.8;margin:6px 0 0}.hero .hint a{color:var(--mint)}
.hero .specimen .stamp.hit{animation:slam .45s cubic-bezier(.2,1.6,.4,1) both}
@view-transition{navigation:auto}
body{background:var(--bg,var(--ink));color:var(--fg,var(--cream))}
.kicker{color:var(--ac,var(--mint))}.kicker span{color:var(--fg,var(--cream))}.kicker a{color:inherit}.top nav a:hover{border-bottom-color:var(--ac,var(--mint))}
.answer{border-color:var(--ac,var(--mint));background:color-mix(in srgb,var(--ac,var(--mint)) 9%,transparent)}.answer b{color:var(--ac,var(--mint))}
.prose a,summary::after{color:var(--ac,var(--mint))}
details,details:first-of-type,.pager{border-color:color-mix(in srgb,currentColor 35%,transparent)}
.themed .btn{background:var(--fg);color:var(--bg)}.themed .btn.ghost{background:transparent;color:inherit}
.showhero{display:grid;gap:10px 40px;align-items:center;padding:10px 0 40px}@media(min-width:900px){.showhero{grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:84vh}}
.showhero h1{font-size:clamp(60px,10.5vw,150px);line-height:.88;letter-spacing:-.04em;font-variation-settings:"wdth" 75;margin:0 0 20px}
.showhero .tag{font-size:clamp(20px,2.4vw,30px);font-weight:700;line-height:1.2;margin:0 0 18px;max-width:18em}
canvas.live{width:100%;aspect-ratio:1/1;display:block;cursor:pointer;touch-action:manipulation;max-height:78vh;-webkit-mask-image:radial-gradient(closest-side,#000 80%,transparent);mask-image:radial-gradient(closest-side,#000 80%,transparent)}
canvas:focus-visible,a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--ac,var(--mint));outline-offset:4px;border-radius:8px}
.bubble{display:block;width:fit-content;max-width:min(24em,100%);margin:14px auto 0;padding:13px 22px 14px;border-radius:20px;background:var(--fg,var(--cream));color:var(--bg,var(--ink));font-weight:700;font-size:18px;line-height:1.25;text-decoration:none;text-align:center;position:relative}
.bubble::before{content:'';position:absolute;left:50%;top:-9px;width:18px;height:18px;margin-left:-9px;background:inherit;transform:rotate(45deg);border-radius:3px}
.bubble small{display:block;font-weight:400;font-size:14px;opacity:.75;margin-top:3px}.bubble.pop{animation:pop .35s cubic-bezier(.3,1.6,.5,1)}@keyframes pop{from{transform:scale(.7);opacity:0}}
.legend{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 16px;list-style:none;padding:0;margin:8px 0 0;font-size:15px}.legend i{display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:6px}
#board{width:100%;aspect-ratio:3/4;display:block;border-radius:18px;background:linear-gradient(#0F1B4A,#060A1E);cursor:pointer;touch-action:manipulation}
.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;z-index:99;background:var(--cream);color:var(--ink);padding:10px 16px;border-radius:10px}
.livewrap{position:relative}.livewrap>img,.livewrap>video{width:100%;border-radius:22px}.livewrap .hint{text-align:center;font-size:15px;opacity:.8;margin:4px 0 0}
.rules{display:grid;gap:22px;margin:0 0 72px}@media(min-width:760px){.rules{grid-template-columns:1fr 1fr}}
.rules div{border-top:3px solid currentColor;padding-top:14px}.rules b{display:block;font-size:15px;color:var(--ac,var(--mint));margin-bottom:6px}.rules span{font-size:clamp(22px,2.6vw,32px);font-weight:700;line-height:1.15;font-variation-settings:"wdth" 86}
.eps{display:grid;gap:22px;list-style:none;margin:0 0 72px;padding:0}@media(min-width:760px){.eps{grid-template-columns:repeat(3,1fr)}}
.ep{display:block;text-decoration:none;border-radius:18px;overflow:hidden;background:color-mix(in srgb,currentColor 9%,transparent);height:100%;transition:transform .15s}.ep:hover{transform:translateY(-5px)}
.ep img{width:100%;aspect-ratio:4/3;object-fit:cover}.ep div{padding:16px 18px 20px}.ep small{display:block;font-size:14px;opacity:.75;margin-bottom:4px}.ep h3{font-size:22px;margin:0 0 8px}.ep p{margin:0;font-size:16px;line-height:1.4;opacity:.85}
.chips{display:flex;gap:10px;flex-wrap:wrap;list-style:none;padding:0;margin:0 0 24px}.chips a,.chip{display:inline-block;padding:8px 16px 9px;border-radius:999px;box-shadow:inset 0 0 0 2px currentColor;text-decoration:none;font-weight:700;font-size:16px}.chips a:hover{background:var(--fg,var(--cream));color:var(--bg,var(--ink))}
.plain h1{font-size:clamp(44px,7vw,92px);max-width:11em}.plain .prose h2{font-size:32px}.plain section{padding:0 0 60px}
.srclist{list-style:none;padding:0;margin:0 0 40px;max-width:46em}.srclist li{padding:14px 0;border-bottom:1.5px solid color-mix(in srgb,currentColor 30%,transparent)}.srclist b{display:block}
#chaos{width:100%;max-width:520px;border-radius:18px;background:linear-gradient(#0C1230,#04050D);cursor:pointer;display:block;margin:0 auto}
.world a.name{text-decoration:none}.world a.name:hover h2{text-decoration:underline;text-decoration-thickness:6px;text-underline-offset:10px}
</style>
</head>
<body style={theme ? `--bg:${theme.bg};--fg:${theme.fg};--ac:${theme.ac}` : undefined}>
<div class="percy" aria-hidden="true"><i></i><b><u></u></b><em>0%</em></div>
<script is:inline>
(() => { const el = document.querySelector('.percy'), em = el.querySelector('em'); let tick = false;
  const up = () => { tick = false; const max = document.documentElement.scrollHeight - innerHeight, p = max > 0 ? scrollY / max : 0, shown = p < .9 ? p / .9 * .99 : (p < .995 ? .99 : 1);
    el.style.setProperty('--sp', (shown * 100).toFixed(2) + '%'); em.textContent = Math.floor(shown * 100) + '%'; el.classList.toggle('stall', shown === .99); el.classList.toggle('on', scrollY > 60); };
  addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(up); } }, { passive: true }); addEventListener('resize', up); up(); })();
</script>
<a class="skip" href="#main">Skip to the content</a>
<div class="wrap"><header class="top">
  <a class="mark" href={u('/')}><img src={u('/img/avatar.jpg')} alt="" width="30" height="30">Vidatu</a>
  <nav aria-label="Main"><a href={u('/#shows')}>Shows</a><a href={u('/lab/')}>Lab</a><a href={u('/sources/')}>Sources</a><a href={u('/about/')}>About</a><a href={u('/brands/')}>For brands</a></nav>
</header></div>
<main id="main"><slot /></main>
<footer><div class="wrap cols">
  <div><b>Vidatu</b>Hidden rules, made visible. One true, surprising thing in 30 seconds, with its sources.<br><br>Animated entirely in code. Voices are AI-generated.</div>
  <div><b>Explore</b><ul><li><a href={u('/oob/')}>Inspector Oob's reports</a></li><li><a href={u('/lab/')}>The Lab</a></li><li><a href={u('/topics/space/')}>Space</a> · <a href={u('/topics/animals/')}>Animals</a> · <a href={u('/topics/maths/')}>Maths</a> · <a href={u('/topics/physics/')}>Physics</a> · <a href={u('/topics/humans/')}>Human life</a></li><li><a href={u('/sources/')}>Sources and corrections</a></li><li><a href="https://www.youtube.com/@vidatutv">YouTube</a></li></ul></div>
  <div><b>For brands</b>We make films like these for products and launches. <a href={u('/brands/')}>See how</a>, or write to <a href="mailto:hello@vidatu.com?subject=A%20video%20for%20our%20brand">hello@vidatu.com</a>.<br><br>A SellnShip Solutions production, Chandigarh.</div>
</div></footer>
</body></html>
