---
import Base from '../../layouts/Base.astro';
import { u, reports } from '../../data/site.js';
export function getStaticPaths() { return reports.map((r, i) => ({ params: { slug: r.slug }, props: { r, prev: reports[i - 1], next: reports[i + 1] } })); }
const { r, prev, next } = Astro.props, url = 'https://vidatu.com/oob/' + r.slug + '/';
const ld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: r.h1, description: r.desc, image: 'https://vidatu.com/img/' + r.img, url, author: { '@type': 'Organization', name: 'Vidatu' }, publisher: { '@type': 'Organization', name: 'Vidatu' }, datePublished: '2026-11-26', dateModified: '2026-11-26' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: r.faq.map(f => ({ '@type': 'Question', name: f[0], acceptedAnswer: { '@type': 'Answer', text: f[1] } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Vidatu', item: 'https://vidatu.com/' }, { '@type': 'ListItem', position: 2, name: 'Inspector Oob', item: 'https://vidatu.com/oob/' }, { '@type': 'ListItem', position: 3, name: r.subject, item: url }] }
];
---
<Base title={r.h1 + ' | Oob Report ' + r.no + ' | Vidatu'} description={r.desc} path={'/oob/' + r.slug + '/'} ld={ld} image={'/img/' + r.img}>
<div class="wrap">
  <p class="crumbs"><a href={u('/')}>Vidatu</a> / <a href={u('/oob/')}>Inspector Oob</a> / Report {r.no}</p>
  <ul class="formline"><li><span>Report</span>{r.no}</li><li><span>Subject</span>{r.subject}</li><li><span>Last checked</span>26 Nov 2026</li></ul>
  <h1>{r.h1}</h1>
  <div class="article">
    <div class="prose">
      <div class="answer"><b>The short answer</b><p>{r.answer}</p></div>
      {r.body.map(p => <p>{p}</p>)}
      <h2>Sources</h2>
      {r.sources.length ? <ol>{r.sources.map(s => <li>{s[0]} <a href={s[1]}>Link</a></li>)}</ol> : <p>None needed: this report is an observation and makes no factual claim.</p>}
      <h2>Questions people ask</h2>
      {r.faq.map(f => <details><summary>{f[0]}</summary><p>{f[1]}</p></details>)}
      <h2>What Oob says, word for word</h2>
      <details><summary>Read the transcript</summary><p>{r.transcript.join(' ')}</p></details>
    </div>
    <aside>
      <figure class="specimen"><img src={u('/img/' + r.img)} alt={'Inspector Oob studying a hologram for Report ' + r.no + ': ' + r.subject} width="720" height="653"><span class={'stamp ' + r.vc}>{r.verdict}</span></figure>
      <p style="margin-top:40px">The 30-second film of this report is coming to <a href="https://www.youtube.com/@vidatutv">YouTube</a>.</p>
    </aside>
  </div>
  <nav class="pager" aria-label="More reports">{prev ? <a href={u('/oob/' + prev.slug + '/')}>← Report {prev.no}: {prev.subject}</a> : <span></span>}{next ? <a href={u('/oob/' + next.slug + '/')}>Report {next.no}: {next.subject} →</a> : <a href={u('/oob/')}>All reports</a>}</nav>
  <div style="height:81px"></div>
</div>
</Base>
