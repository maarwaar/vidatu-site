---
import Base from '../../layouts/Base.astro';
import { u, reports } from '../../data/site.js';
const ld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Vidatu', item: 'https://vidatu.com/' }, { '@type': 'ListItem', position: 2, name: 'Inspector Oob', item: 'https://vidatu.com/oob/' }] }];
---
<Base title="Inspector Oob: field reports on humans | Vidatu" description="An alien auditor studies one human habit at a time and stamps a verdict. All of Inspector Oob's reports, with the research behind them." path="/oob/" ld={ld} image="/img/oob.jpg">
<div class="wrap" style="padding-top:30px">
  <p class="crumbs"><a href={u('/')}>Vidatu</a> / Inspector Oob</p>
  <div class="hero" style="padding-top:0">
    <div>
      <ul class="kicker"><li><span>Show</span>Reports</li><li><span>Length</span>30 seconds each</li></ul>
      <h1>Inspector Oob</h1>
      <p class="lede">An alien auditor sent to study humans. He picks one habit, describes it exactly as it looks from outside, and stamps a verdict. He is growing fond of the species and would rather not discuss it.</p>
      <ul class="kicker"><li><span>Always</span>opens with the report number, ends on the stamp</li><li><span>Never</span>mocks a culture, a country or a group</li></ul>
    </div>
    <figure class="specimen"><img style="border-radius:28px;max-width:420px;width:100%;margin:0 auto" src={u('/img/avatar.jpg')} alt="Inspector Oob: a violet, teardrop-shaped alien with one antenna and a dark visor showing a mint-green smile" width="720" height="720"></figure>
  </div>
  <section style="padding-bottom:80px">
    <h2>All reports</h2>
    <ol class="holos">{reports.map(r => <li><a class="holo" href={u('/oob/' + r.slug + '/')}><span class="no">REPORT {r.no}</span><h3>{r.h1}</h3><p>{r.finding}</p><span class={'stamp ' + r.vc}>{r.verdict}</span></a></li>)}
      <li><div class="holo" style="opacity:.55"><span class="no">REPORT 004</span><h3>Small talk</h3><p>Inspection in progress.</p></div></li></ol>
  </section>
</div>
</Base>
