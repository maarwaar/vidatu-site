---
import { u } from '../data/site.js';
const { title, description, show = 'oob', path = '/', ld = [], image = '/img/avatar.jpg' } = Astro.props;
const canon = 'https://vidatu.com' + path;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Vidatu', url: 'https://vidatu.com/', logo: 'https://vidatu.com/img/avatar.jpg', sameAs: ['https://www.youtube.com/@vidatutv'] };
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title><meta name="description" content={description}>
<link rel="canonical" href={canon}><link rel="icon" href={u('/img/avatar.jpg')}>
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={'https://vidatu.com' + image}><meta property="og:url" content={canon}><meta property="og:site_name" content="Vidatu"><meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&display=swap" rel="stylesheet">
{[org, ...ld].map(x => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
<style is:global>
:root{--paper:#EAF0E3;--rule:#C3CFB8;--ink:#17122B;--oob:#5B3FD9;--mint:#7CFFCB;--amber:#FFB52E;--night:#0B1026;--absurd:#D8362F;--approved:#17804A;--review:#5B3FD9;--line:27px}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;color:var(--ink);background:var(--paper);font-family:"Bricolage Grotesque",system-ui,sans-serif;font-size:18px;line-height:var(--line)}
a{color:inherit}a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible{outline:3px solid var(--oob);outline-offset:3px;border-radius:3px}
img,video{max-width:100%;display:block}
.wrap{max-width:1120px;margin:0 auto;padding:0 22px}
.paper{background-image:repeating-linear-gradient(to bottom,transparent 0,transparent calc(var(--line) - 1px),var(--rule) calc(var(--line) - 1px),var(--rule) var(--line))}
.top{display:flex;justify-content:space-between;align-items:baseline;gap:4px 24px;flex-wrap:wrap;padding:26px 0 0}
.mark{font-weight:800;font-size:23px;text-decoration:none;letter-spacing:-.01em;display:flex;align-items:center;gap:10px}
.mark img{width:30px;height:30px;border-radius:50%}
.top nav{display:flex;gap:4px 18px;flex-wrap:wrap;font-size:16px}.top nav a{text-decoration:none;border-bottom:2px solid transparent}.top nav a:hover,.top nav a[aria-current]{border-bottom-color:var(--oob)}
h1{font-size:clamp(42px,7.4vw,86px);line-height:.94;margin:0 0 27px;font-weight:800;font-variation-settings:"wdth" 82;letter-spacing:-.025em;max-width:9em}
h2{font-size:clamp(30px,5vw,52px);line-height:1;margin:0 0 27px;font-weight:800;font-variation-settings:"wdth" 86;letter-spacing:-.02em}
h3{font-size:24px;line-height:var(--line);margin:0;font-weight:700}
p{margin:0 0 27px}.lede{font-size:21px;max-width:34em}.note{max-width:38em}
.formline{display:flex;gap:6px 28px;flex-wrap:wrap;font-size:15px;margin:0 0 27px;padding:0;list-style:none}.formline span{opacity:.6;margin-right:8px}
.btn{display:inline-block;background:var(--oob);color:#fff;text-decoration:none;font-weight:700;padding:13px 22px 14px;border-radius:999px;line-height:1.2;border:0;font:inherit;font-weight:700;cursor:pointer}
.btn:hover{background:var(--ink)}.btn.ghost{background:transparent;color:inherit;box-shadow:inset 0 0 0 2px currentColor}.btn.ghost:hover{background:var(--ink);color:var(--paper)}
.actions{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.stamp{display:inline-block;font-weight:800;font-variation-settings:"wdth" 75;text-transform:uppercase;letter-spacing:.06em;line-height:1;padding:7px 12px 8px;border:3px solid currentColor;border-radius:6px;transform:rotate(-7deg);white-space:nowrap}
.stamp.absurd{color:var(--absurd)}.stamp.approved{color:var(--approved)}.stamp.review{color:var(--review)}
section{padding:0 0 81px}
.hero{display:grid;gap:27px;padding:54px 0 81px;align-items:center}
@media(min-width:900px){.hero{grid-template-columns:1.2fr .8fr;padding:81px 0 108px}}
.specimen{position:relative;margin:0}.specimen video,.specimen img{width:100%;height:auto;border-radius:6px}
.specimen .stamp{position:absolute;right:-8px;bottom:-14px;font-size:clamp(18px,2.6vw,28px);background:var(--paper)}
@media(prefers-reduced-motion:no-preference){.specimen .stamp{animation:slam .5s cubic-bezier(.2,1.6,.4,1) .9s both}@keyframes slam{from{opacity:0;transform:rotate(-18deg) scale(2.6)}to{opacity:1;transform:rotate(-7deg) scale(1)}}}
.reports{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}
.reports li{border-bottom:2px solid var(--ink)}
.reports a{display:grid;grid-template-columns:64px 1fr;gap:4px 16px;padding:26px 0 27px;align-items:center;text-decoration:none}
.reports a:hover h3{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:4px}
.reports .no{font-weight:800;font-size:30px;font-variation-settings:"wdth" 75}.reports p{margin:0;grid-column:2}.reports .verdict{grid-column:2;margin-top:10px}.reports .stamp{font-size:18px}
@media(min-width:760px){.reports a{grid-template-columns:84px 1fr auto}.reports .verdict{grid-column:3;grid-row:1 / span 2;margin:0}.reports .stamp{font-size:24px}}
.shows{display:grid;gap:14px;grid-template-columns:1fr 1fr}
.shows .show:first-child{grid-column:span 2}
@media(min-width:1000px){.shows{gap:18px;grid-template-columns:repeat(12,1fr)}.shows .show{grid-column:span 3}.shows .show:first-child{grid-column:span 8;grid-row:span 2}.shows .show:nth-child(2),.shows .show:nth-child(3){grid-column:span 4}}
.show{display:flex;flex-direction:column;border-radius:10px;overflow:hidden;text-decoration:none;min-height:100%}
.show img{width:100%;aspect-ratio:4/3;object-fit:cover}.show:first-child img{aspect-ratio:16/11}
.show div{padding:12px 14px 16px}@media(min-width:620px){.show div{padding:16px 18px 20px}}.show b{display:block;font-size:clamp(19px,2.6vw,24px);font-weight:800;line-height:1.1}.show small{display:block;font-size:14px;opacity:.75;margin-bottom:6px}.show span{font-size:clamp(14px,1.9vw,16px);line-height:1.35;display:block}
a.show:hover b{text-decoration:underline;text-underline-offset:4px}
.lab{background:var(--night);color:#E8ECFF;padding:81px 0;margin:0 0 81px}
.lab h2{color:var(--amber)}.lab .grid{display:grid;gap:27px;align-items:center}@media(min-width:900px){.lab .grid{grid-template-columns:.9fr 1.1fr}}
#wave{width:100%;height:440px;border-radius:10px;background:linear-gradient(#16245A,#070B20);cursor:pointer;touch-action:manipulation}
.controls{display:flex;gap:10px 18px;align-items:center;flex-wrap:wrap;margin-top:14px;font-size:16px}.controls input{accent-color:var(--amber)}.controls .btn{background:var(--amber);color:var(--ink);padding:9px 16px 10px}
#wave-t{font-variant-numeric:tabular-nums}
.crumbs{font-size:15px;padding:27px 0 0;margin:0 0 27px}.crumbs a{text-underline-offset:3px}
.article{display:grid;gap:27px 54px;padding-bottom:54px}@media(min-width:960px){.article{grid-template-columns:minmax(0,1fr) 360px;align-items:start}.article aside{position:sticky;top:27px}}
@media(max-width:959px){.article aside{order:-1}.article aside p{display:none}}
.answer{background:var(--ink);color:var(--paper);border-radius:10px;padding:26px 24px 1px;margin:0 0 27px}.answer b{display:block;color:var(--mint);font-size:15px;margin-bottom:6px}.answer p{font-size:21px;line-height:1.4}
.prose p{max-width:36em}.prose h2{font-size:30px;margin-top:27px}
.prose ol{margin:0 0 27px;padding-left:22px;max-width:36em}
details{border-bottom:2px solid var(--ink);max-width:40em}details:first-of-type{border-top:2px solid var(--ink)}
summary{cursor:pointer;font-weight:700;font-size:20px;padding:13px 0 14px;list-style:none;display:flex;justify-content:space-between;gap:16px}summary::-webkit-details-marker{display:none}summary::after{content:"+";font-weight:400}details[open] summary::after{content:"−"}details>*:not(summary){margin:0 0 27px}
.pager{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;border-top:2px solid var(--ink);padding:26px 0 0;margin-top:54px}
footer{background:var(--ink);color:var(--paper);padding:54px 0;font-size:16px}footer .cols{display:grid;gap:27px}@media(min-width:760px){footer .cols{grid-template-columns:1.4fr 1fr 1fr}}footer b{display:block;margin-bottom:8px;color:var(--mint)}footer ul{list-style:none;margin:0;padding:0}footer a{text-underline-offset:3px}
</style>
</head>
<body data-show={show}>
<div class="paper">
<div class="wrap"><header class="top">
  <a class="mark" href={u('/')}><img src={u('/img/avatar.jpg')} alt="" width="30" height="30">Vidatu</a>
  <nav aria-label="Main"><a href={u('/oob/')}>Shows</a><a href={u('/#lab')}>Lab</a><a href={u('/#sources')}>Sources</a><a href={u('/#brands')}>For brands</a></nav>
</header></div>
<main><slot /></main>
</div>
<footer><div class="wrap cols">
  <div><b>Vidatu</b>Hidden rules, made visible. One true, surprising thing in 30 seconds, with its sources.<br><br>Animated entirely in code. Voices are AI-generated.</div>
  <div><b>Watch</b><ul><li><a href="https://www.youtube.com/@vidatutv">YouTube</a></li><li><a href={u('/oob/')}>Inspector Oob's reports</a></li></ul></div>
  <div id="brands"><b>For brands</b>We make films like these for products and launches. A SellnShip Solutions production, Chandigarh.<br><a href="mailto:hello@vidatu.com?subject=A%20video%20for%20our%20brand">hello@vidatu.com</a></div>
</div></footer>
</body></html>
