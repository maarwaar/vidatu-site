---
import { u, beacon } from '../data/site.js';
const { title, description, show = 'oob', path = '/', ld = [], image = '/img/avatar.jpg' } = Astro.props;
const canon = 'https://vidatu.com' + path;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Vidatu', url: 'https://vidatu.com/', logo: 'https://vidatu.com/img/avatar.jpg', sameAs: ['https://www.youtube.com/@vidatutv'] };
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title><meta name="description" content={description}>
<link rel="canonical" href={canon}>{import.meta.env.BASE_URL !== "/" && <meta name="robots" content="noindex">}{beacon && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}<link rel="icon" href={u('/img/avatar.jpg')}>
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={'https://vidatu.com' + image}><meta property="og:url" content={canon}><meta property="og:site_name" content="Vidatu"><meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&display=swap" rel="stylesheet">
{[org, ...ld].map(x => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
<style is:global>
:root{--ink:#120E2A;--violet:#1A1340;--cream:#FBF7EA;--mint:#7CFFCB;--amber:#FFB52E;--oob:#6C4DFF;--absurd:#FF6B5E;--approved:#4DE08A;--review:#B9A6FF}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;color:var(--cream);background:var(--ink);font-family:"Bricolage Grotesque",system-ui,sans-serif;font-size:18px;line-height:1.5}
a{color:inherit}a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible{outline:3px solid var(--mint);outline-offset:3px;border-radius:3px}
img,video{max-width:100%;display:block}
.wrap{max-width:1160px;margin:0 auto;padding:0 22px}
.top{display:flex;justify-content:space-between;align-items:center;gap:6px 24px;flex-wrap:wrap;padding:22px 0}
.mark{font-weight:800;font-size:24px;text-decoration:none;letter-spacing:-.01em;display:flex;align-items:center;gap:10px}.mark img{width:34px;height:34px;border-radius:50%}
.top nav{display:flex;gap:4px 20px;flex-wrap:wrap;font-size:16px}.top nav a{text-decoration:none;border-bottom:2px solid transparent;padding-bottom:2px}.top nav a:hover{border-bottom-color:var(--mint)}
h1{font-size:clamp(46px,8.2vw,112px);line-height:.9;margin:0 0 26px;font-weight:800;font-variation-settings:"wdth" 78;letter-spacing:-.03em}
h2{font-size:clamp(32px,5.2vw,60px);line-height:.98;margin:0 0 26px;font-weight:800;font-variation-settings:"wdth" 84;letter-spacing:-.02em}
h3{font-size:23px;line-height:1.2;margin:0;font-weight:700}
p{margin:0 0 24px}.lede{font-size:clamp(19px,2vw,23px);max-width:30em;line-height:1.45}.note{max-width:36em}
.kicker{display:flex;gap:6px 26px;flex-wrap:wrap;font-size:15px;margin:0 0 24px;padding:0;list-style:none;color:var(--mint)}.kicker span{opacity:.7;margin-right:8px;color:var(--cream)}
.btn{display:inline-block;background:var(--amber);color:var(--ink);text-decoration:none;padding:14px 24px 15px;border-radius:999px;line-height:1.2;border:0;font:inherit;font-weight:700;cursor:pointer}
.btn:hover{background:var(--cream)}.btn.ghost{background:transparent;color:inherit;box-shadow:inset 0 0 0 2px currentColor}.btn.ghost:hover{background:var(--cream);color:var(--ink)}
.actions{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.stamp{display:inline-block;font-weight:800;font-variation-settings:"wdth" 75;text-transform:uppercase;letter-spacing:.06em;line-height:1;padding:7px 12px 8px;border:3px solid currentColor;border-radius:6px;transform:rotate(-7deg);white-space:nowrap}
.stamp.absurd{color:var(--absurd)}.stamp.approved{color:var(--approved)}.stamp.review{color:var(--review)}
.band{padding:72px 0}
.stage{background:var(--violet);position:relative;overflow:hidden}
.stage::before{content:"";position:absolute;inset:auto auto -30% -10%;width:70%;aspect-ratio:1;border-radius:50%;background:radial-gradient(closest-side,rgba(108,77,255,.55),transparent);pointer-events:none}
.hero{display:grid;gap:10px 40px;align-items:center;padding:26px 0 40px;position:relative}
@media(min-width:900px){.hero{grid-template-columns:1.15fr .85fr;padding:20px 0 30px}}
.hero h1 em{font-style:normal;color:var(--amber)}
.specimen{position:relative;margin:0}
.hero .specimen video{width:100%;max-width:470px;margin:0 auto;-webkit-mask-image:radial-gradient(ellipse 62% 60% at 50% 48%,#000 68%,transparent 100%);mask-image:radial-gradient(ellipse 62% 60% at 50% 48%,#000 68%,transparent 100%)}
.hero .specimen .stamp{position:absolute;left:2%;bottom:9%;font-size:clamp(20px,2.6vw,30px);background:var(--violet)}
@media(prefers-reduced-motion:no-preference){.specimen .stamp{animation:slam .5s cubic-bezier(.2,1.6,.4,1) 1s both}@keyframes slam{from{opacity:0;transform:rotate(-18deg) scale(2.6)}to{opacity:1;transform:rotate(-7deg) scale(1)}}}
.holos{display:grid;gap:16px;list-style:none;margin:0;padding:0}@media(min-width:860px){.holos{grid-template-columns:repeat(3,1fr)}}
.holo{display:flex;flex-direction:column;gap:12px;height:100%;padding:22px 22px 24px;border:1.5px solid var(--mint);border-radius:16px;text-decoration:none;color:var(--cream);
  background:repeating-linear-gradient(to bottom,rgba(124,255,203,.07) 0 2px,transparent 2px 6px),rgba(124,255,203,.05);box-shadow:0 0 34px rgba(124,255,203,.13);transition:transform .15s}
a.holo:hover{transform:translateY(-4px);box-shadow:0 0 46px rgba(124,255,203,.3)}
.holo .no{color:var(--mint);font-weight:800;font-size:17px;letter-spacing:.08em}.holo p{margin:0;opacity:.85;font-size:16px;line-height:1.45}.holo .stamp{font-size:18px;align-self:flex-start;margin-top:auto}
.world{padding:64px 0;background:var(--bg);color:var(--fg);overflow:hidden}
.world .grid{display:grid;gap:26px 48px;align-items:center}@media(min-width:860px){.world .grid{grid-template-columns:1fr 1fr}.world:nth-of-type(even) .pic{order:2}}
.world h2{font-size:clamp(60px,12vw,168px);line-height:.82;margin:0 0 18px;font-variation-settings:"wdth" 75;letter-spacing:-.035em}
.world .fmt{font-weight:700;font-size:16px;letter-spacing:.04em;margin:0 0 14px;opacity:.85}
.world p.line{font-size:clamp(19px,2.1vw,24px);line-height:1.35;max-width:22em;margin:0 0 20px}
.world .pic video,.world .pic img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:22px;box-shadow:0 26px 60px rgba(0,0,0,.35);transform:rotate(-2deg)}.world:nth-of-type(even) .pic video{transform:rotate(2deg)}
.world .soon{display:inline-block;font-size:15px;font-weight:700;padding:7px 14px 8px;border-radius:999px;box-shadow:inset 0 0 0 2px currentColor;opacity:.85}
.lab{background:#070B20;padding:80px 0}.lab h2{color:var(--amber)}.lab .grid{display:grid;gap:27px 48px;align-items:center}@media(min-width:900px){.lab .grid{grid-template-columns:.9fr 1.1fr}}
#wave{width:100%;height:440px;border-radius:18px;background:linear-gradient(#16245A,#0A0F2A);cursor:pointer;touch-action:manipulation}
.controls{display:flex;gap:10px 18px;align-items:center;flex-wrap:wrap;margin-top:14px;font-size:16px}.controls input{accent-color:var(--amber)}.controls .btn{padding:9px 16px 10px}#wave-t{font-variant-numeric:tabular-nums}
.light{background:var(--cream);color:var(--ink)}
.crumbs{font-size:15px;margin:0 0 24px;opacity:.85}.crumbs a{text-underline-offset:3px}
.article{display:grid;gap:27px 54px;padding-bottom:54px}@media(min-width:960px){.article{grid-template-columns:minmax(0,1fr) 380px;align-items:start}.article aside{position:sticky;top:27px}}
@media(max-width:959px){.article aside{order:-1}.article aside p{display:none}}
.article aside img{border-radius:18px}.article aside .stamp{position:absolute;right:-6px;bottom:-12px;font-size:24px;background:var(--ink)}
.answer{border:1.5px solid var(--mint);background:rgba(124,255,203,.06);border-radius:16px;padding:24px 24px 2px;margin:0 0 27px}.answer b{display:block;color:var(--mint);font-size:15px;margin-bottom:6px}.answer p{font-size:21px;line-height:1.4}
.prose p,.prose ol{max-width:36em}.prose h2{font-size:30px;margin-top:34px}.prose ol{margin:0 0 27px;padding-left:22px}.prose a{color:var(--mint)}
details{border-bottom:1.5px solid rgba(251,247,234,.35);max-width:40em}details:first-of-type{border-top:1.5px solid rgba(251,247,234,.35)}
summary{cursor:pointer;font-weight:700;font-size:20px;padding:14px 0;list-style:none;display:flex;justify-content:space-between;gap:16px}summary::-webkit-details-marker{display:none}summary::after{content:"+";font-weight:400;color:var(--mint)}details[open] summary::after{content:"−"}details>*:not(summary){margin:0 0 24px}
.pager{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;border-top:1.5px solid rgba(251,247,234,.35);padding:24px 0 0;margin-top:54px}
footer{background:#0B0819;color:var(--cream);padding:54px 0;font-size:16px}footer .cols{display:grid;gap:27px}@media(min-width:760px){footer .cols{grid-template-columns:1.4fr 1fr 1fr}}footer b{display:block;margin-bottom:8px;color:var(--mint)}footer ul{list-style:none;margin:0;padding:0}footer a{text-underline-offset:3px}
</style>
</head>
<body data-show={show}>
<div class="stage"><div class="wrap"><header class="top">
  <a class="mark" href={u('/')}><img src={u('/img/avatar.jpg')} alt="" width="30" height="30">Vidatu</a>
  <nav aria-label="Main"><a href={u('/oob/')}>Shows</a><a href={u('/#lab')}>Lab</a><a href={u('/#sources')}>Sources</a><a href={u('/#brands')}>For brands</a></nav>
</header></div></div>
<main><slot /></main>
<footer><div class="wrap cols">
  <div><b>Vidatu</b>Hidden rules, made visible. One true, surprising thing in 30 seconds, with its sources.<br><br>Animated entirely in code. Voices are AI-generated.</div>
  <div><b>Watch</b><ul><li><a href="https://www.youtube.com/@vidatutv">YouTube</a></li><li><a href={u('/oob/')}>Inspector Oob's reports</a></li></ul></div>
  <div id="brands"><b>For brands</b>We make films like these for products and launches. A SellnShip Solutions production, Chandigarh.<br><a href="mailto:hello@vidatu.com?subject=A%20video%20for%20our%20brand">hello@vidatu.com</a></div>
</div></footer>
</body></html>
